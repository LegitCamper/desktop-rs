# desktop-rs entry point. Change this path to select another bundled palette.
import "themes/tokyo-night.nbcl" as theme

component Pill (any: props) {
    Box {
        width         = props.width
        background    = theme.muted
        corner_radius = 6
        align          = "center"
        padding        = 7
        self.children
    }
}

Bar {
    height         = 40
    anchor         = ["top", "left", "right"]
    layer          = "top"
    exclusive_zone = 40
    background     = theme.base
    padding        = 6
    gap            = 8
    align          = "center"

    Pill {
        width = "fit"
        Workspaces {
            width             = "fit"
            color             = theme.text
            active_color      = theme.accent
            active_background = theme.surface
            urgent_color      = theme.error
            font_size         = 14
            gap               = 4
        }
    }
    ActiveWindow {
        width       = "grow"
        color       = theme.text
        font_size   = 14
        text_align  = "center"
        max_chars   = 60
        empty_value = "desktop-rs"
    }
    Tray {
        width     = "fit"
        color     = theme.text
        font_size = 12
        icon_size = 20
        gap       = 4
    }
    Audio {
        width      = "fit"
        color      = theme.text
        font_size  = 14
        step       = 5
        max_volume = 100
    }
    Clock {
        width      = "fit"
        format     = "%a %b %-d  %H:%M:%S"
        color      = theme.text
        font_size  = 14
        text_align = "end"
    }
}

Notification {
    width         = 380
    height        = 96
    anchor        = ["top", "right"]
    layer         = "overlay"
    margin        = { top = 52 right = 12 }
    background    = theme.surface
    border        = theme.border
    border_width  = 1
    corner_radius = 12
    padding       = 12
    gap           = 10
    align         = "center"

    animation = {
        slide       = "right"
        distance    = 400
        duration_ms = 220
        hold_ms     = 4000
    }

    Box { width = 8 background = theme.accent corner_radius = 4 }
    Box {
        width      = "grow"
        direction  = "column"
        gap        = 4
        Text { height = "fit" value = "{summary}" color = theme.text font_size = 15 }
        Text { height = "fit" value = "{body}" color = theme.muted font_size = 13 }
    }
}

Launcher {
    width                  = 640
    height                 = 320
    layer                  = "overlay"
    keyboard_interactivity = "exclusive"
    background             = theme.surface
    border                 = theme.border
    border_width           = 1
    corner_radius          = 14
    padding                = 14
    gap                    = 10
    direction              = "column"

    animation = { slide = "top" distance = 24 duration_ms = 160 }

    AppSearch {
        height        = 44
        background    = theme.muted
        corner_radius = 8
        padding       = 12
        value         = "Search applications…"
        color         = theme.text
        font_size     = 16
    }
    AppList {
        height    = "grow"
        direction = "column"
        gap       = 2
        rows      = 6
        color     = theme.text
        font_size = 14
    }
}
