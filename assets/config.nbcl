# desktop-rs entry point. Change this path to select another bundled palette.
import "themes/tokyo-night.nbcl" as theme

component Pill (any: props) {
    Box {
        width         = props.width
        background    = theme.muted
        corner_radius = 6
        align          = "center"
        padding        = 7
        self.children
    }
}

Bar {
    height          = 40
    expanded_height = 320
    anchor          = ["top", "left", "right"]
    layer           = "top"
    exclusive_zone  = 40
    background      = theme.base
    padding         = 0
    gap             = 0
    direction       = "column"

    Box {
        height  = 40
        padding = 6
        gap     = 8
        align   = "center"

        Pill {
            width = "fit"
            Workspaces {
                width             = "fit"
                color             = theme.text
                active_color      = theme.accent
                active_background = theme.surface
                urgent_color      = theme.error
                font_size         = 14
                gap               = 4
            }
        }
        ActiveWindow {
            width       = "grow"
            color       = theme.text
            font_size   = 14
            text_align  = "center"
            max_chars   = 60
            empty_value = "desktop-rs"
        }
        Tray {
            width     = "fit"
            color     = theme.text
            font_size = 12
            icon_size = 20
            gap       = 4
        }
        Audio {
            width      = "fit"
            target     = "sink"
            format     = "{icon} {volume}%"
            icon       = "VOL"
            muted_icon = "MUTED"
            color      = theme.text
            font_size  = 14
            step       = 5
            max_volume = 100
        }
        Battery {
            width     = "fit"
            format    = "{icon} {capacity}%"
            icon      = "BAT"
            color     = theme.text
            font_size = 14
        }
        Backlight {
            width     = "fit"
            format    = "{icon} {percent}%"
            icon      = "BRT"
            color     = theme.text
            font_size = 14
        }
        Network {
            width               = "fit"
            format              = "{iface} {ssid} {signal}% {ipv4}/{prefix}"
            disconnected_format = "disconnected"
            interval            = 5
            color               = theme.text
            font_size           = 14
        }
        Bluetooth {
            width     = "fit"
            format    = "BT {connected}"
            interval  = 5
            color     = theme.text
            font_size = 14
        }
        Clock {
            width      = "fit"
            format     = "%a %b %-d  %H:%M:%S"
            color      = theme.text
            font_size  = 14
            text_align = "end"
        }
    }

    # Drops down on hover; click it to pin it open. Holds any widget the bar can.
    Reveal "panel:main" {
        height     = "grow"
        background = theme.surface
        padding    = 16
        gap        = 12
        direction  = "column"

        Clock {
            height     = "fit"
            format     = "%A, %B %-d"
            color      = theme.text
            font_size  = 28
            text_align = "center"
        }
        Network {
            height              = "fit"
            format              = "{iface}  {ssid}  {signal}%  {ipv4}/{prefix}"
            disconnected_format = "no network"
            interval            = 5
            color               = theme.muted
            font_size           = 14
            text_align          = "center"
        }
        Battery {
            height     = "fit"
            format     = "battery {capacity}% {status}"
            color      = theme.muted
            font_size  = 14
            text_align = "center"
        }
    }
}

Notification {
    width         = 380
    height        = 96
    anchor        = ["top", "right"]
    layer         = "overlay"
    margin        = { top = 52 right = 12 }
    background    = theme.surface
    border        = theme.border
    border_width  = 1
    corner_radius = 12
    padding       = 12
    gap           = 10
    align         = "center"

    animation = {
        slide       = "right"
        distance    = 400
        duration_ms = 220
        hold_ms     = 4000
    }

    Box { width = 8 background = theme.accent corner_radius = 4 }
    Box {
        width      = "grow"
        direction  = "column"
        gap        = 4
        Text { height = "fit" value = "{summary}" color = theme.text font_size = 15 }
        Text { height = "fit" value = "{body}" color = theme.muted font_size = 13 }
    }
}

Launcher {
    width                  = 640
    height                 = 320
    layer                  = "overlay"
    keyboard_interactivity = "exclusive"
    background             = theme.surface
    border                 = theme.border
    border_width           = 1
    corner_radius          = 14
    padding                = 14
    gap                    = 10
    direction              = "column"

    animation = { slide = "top" distance = 24 duration_ms = 160 }

    AppSearch {
        height        = 44
        background    = theme.muted
        corner_radius = 8
        padding       = 12
        value         = "Search applications…"
        color         = theme.text
        font_size     = 16
    }
    AppList {
        height    = "grow"
        direction = "column"
        gap       = 2
        rows      = 6
        icon_size = 24
        icon_theme = "hicolor"
        color     = theme.text
        font_size = 14
    }
}
